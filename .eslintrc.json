{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module", "project": false },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unsafe-assignment": "warn",
    "@typescript-eslint/no-unsafe-member-access": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/infrastructure/**"],
            "message": "UI/ViewModel/Store → infrastructure is FORBIDDEN (D09 §66). Use Facade → Service → Adapter."
          }
        ]
      }
    ],
    "import/no-cycle": ["error", { "maxDepth": 8 }],
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      "files": ["src/core/application/viewmodels/**", "src/features/**/viewmodels/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/repositories/**", "**/infrastructure/**"], "message": "ViewModel → repositories/infrastructure is FORBIDDEN (D09 §34)" },
              { "group": ["**/adapters/**", "**/sync/**", "**/android/**"], "message": "ViewModel → Adapter/Authority is FORBIDDEN — use Facade" }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/application/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/viewmodels/**", "**/stores/**", "**/ui/**"], "message": "Service → Presentation is FORBIDDEN (one-way only)" }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/application/adapters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**/viewmodels/**", "**/stores/**", "**/facade/**"], "message": "Adapter → Presentation is FORBIDDEN" }]
          }
        ]
      }
    },
    {
      "files": ["src/core/application/di/**", "src/core/application/bootstrap.ts", "**/__tests__/**"],
      "rules": { "no-restricted-syntax": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "tools"]
}
