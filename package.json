{
  "name": "8bitai",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "8bitAI — Level 4 Device Agent (D00–D09) — Contract-first",
  "scripts": {
    "lint:arch": "node tools/arch-lint/lint.mjs",
    "lint:arch:verbose": "node tools/arch-lint/lint.mjs --verbose",
    "lint:types": "tsc --noEmit -p tsconfig.application.json",
    "lint:types:all": "tsc --noEmit",
    "lint:no-any": "node tools/arch-lint/check-no-any.mjs",
    "check": "npm run lint:arch && npm run lint:no-any && npm run lint:types",
    "check:ci": "npm run check --silent",
    "test:contracts": "tsx tests/adapter-contract/runner.ts",
    "bootstrap": "tsx src/core/application/bootstrap.ts",
    "build": "npx next build",
    "sync": "npx cap sync android",
    "dev": "npx next dev -p 3000"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
